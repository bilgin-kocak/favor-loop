# Copy to .env for local runs (bun reads it automatically). Never commit real values.
TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=http://localhost:8080
# The app token for Agent Village: generate with `openssl rand -hex 32`, give it to the organisers privately.
MINI_APP_FAVORLOOP_KEY=
# Comma-separated Telegram user ids allowed to use /stats and to receive /report messages.
ADMIN_TG_IDS=
DB_PATH=./data/favorloop.db
# Required, at least 32 characters (openssl rand -hex 32): the server refuses to start without it.
# Set once and never change: every member id is an HMAC under this salt.
HASH_SALT=
DELETE_ALL_AT=2026-11-30T00:00:00+05:30
